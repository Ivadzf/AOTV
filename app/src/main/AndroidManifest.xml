<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Saber se a rede é de dados móveis. Os selos do pôster não leem fontes em segundo plano nela. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Busca por voz (Lote 3, item 1): pedida em runtime só quando o microfone é tocado. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Gravações (Lote 8): aviso de início/fim/falha (Android 13+, pedido em runtime ao agendar) e serviço em 2º plano. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Microfone opcional: aparelho sem ele instala normal e a busca por voz some. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".AotvApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher_foreground"
        android:roundIcon="@drawable/ic_launcher_foreground"
        android:banner="@drawable/ic_launcher_foreground"
        android:theme="@style/Theme.AOTV"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true">

        <!-- Google Cast: aponta pro provider de opções -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.aotv.app.CastOptionsProvider" />

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:screenOrientation="fullUser"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- AniList (v1.17.0): retorno do OAuth no navegador para o app (aotv://anilist/callback). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aotv" android:host="anilist" android:path="/callback" />
            </intent-filter>
            <!-- Watch Party (Lote 10, v1.20.0): convite por deep link (aotv://party/?code=XXXXXX). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aotv" android:host="party" />
            </intent-filter>
        </activity>

        <!-- Ícones coloridos (Lote 11, v1.21.0 — ideia do Tuvora): um alias por
             cor, todos DESLIGADOS por padrão. O ícone atual continua sendo a
             MainActivity (sem alias). Trocar o ícone liga o alias da cor e
             desliga a MainActivity (ver AppIconVariants.applyVariant); voltar
             ao Padrão faz o contrário. Os deep links (AniList e Watch Party)
             estão duplicados em cada alias porque, com a MainActivity
             desligada, o link só resolve no alias ativo — em cada estado só
             UM componente está ligado. O banner é o mesmo do app em todos. -->
        <activity-alias
            android:name=".AppIconRed"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_red"
            android:roundIcon="@mipmap/ic_launcher_red"
            android:banner="@drawable/ic_launcher_foreground"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aotv" android:host="anilist" android:path="/callback" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aotv" android:host="party" />
            </intent-filter>
        </activity-alias>

