<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Saber se a rede é de dados móveis. Os selos do pôster não leem fontes em segundo plano nela. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Busca por voz (Lote 3, item 1): pedida em runtime só quando o microfone é tocado. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Watch Party real (Lote 19, v1.29.0): a câmera do celular vira a
         câmera da TV. Pedida em runtime só quando a câmera é ligada na sala. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Gravações (Lote 8): aviso de início/fim/falha (Android 13+, pedido em runtime ao agendar) e serviço em 2º plano. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Atualizador dentro do app (Lote 12, v1.22.0): instalar o APK baixado
         da release oficial do GitHub. A permissão é pedida em runtime só
         quando o usuário aceita instalar a atualização. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- VPN (Lote VPN, v1.40.0): o serviço de VPN do app. Os DOIS motores
         trazem o próprio VpnService declarado no manifesto do AAR (merge
         automático) — GoBackend$VpnService (WireGuard) e
         com.tim.openvpn.service.OpenVPNService (OpenVPN, processo
         :openvpn, foregroundServiceType specialUse) — ambos com
         android:permission="android.permission.BIND_VPN_SERVICE" no
         serviço. O uses-permission abaixo não concede nada ao app (é
         permissão de assinatura, p/ proteger o serviço); o
         FOREGROUND_SERVICE_SPECIAL_USE é o que o serviço specialUse do
         OpenVPN exige no targetSdk 35. -->
    <uses-permission android:name="android.permission.BIND_VPN_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Send to TV (Lote 22, item 2): a descoberta SSDP/mDNS usa multicast
         (MulticastLock) — permissão normal, concedida na instalação, sem
         pedido em runtime. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Player externo (Lote 22, item 6): no Android 11+, listar os players
         instalados (queryIntentActivities p/ ACTION_VIEW video/*) exige o
         bloco <queries> — sem ele a lista vem vazia e o seletor não aparece. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
    </queries>
    <!-- Microfone opcional: aparelho sem ele instala normal e a busca por voz some. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Câmera opcional (Watch Party, Lote 19): aparelho sem ela (TV) instala
         normal e a câmera da sala some — a voz continua funcionando. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- TV (Lote 13, v1.23.0): telas grandes são o caso da TV — a Philco do
         Davi é 1080p. Declarar large/xlarge não muda nada no celular
         (small/normal continuam true) e deixa explícito que o app é p/ TV. -->
    <supports-screens
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="true"
        android:xlargeScreens="true" />

    <application
        android:name=".AotvApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher_foreground"
        android:roundIcon="@drawable/ic_launcher_foreground"
        android:banner="@drawable/ic_launcher_foreground"
        android:theme="@style/Theme.AOTV"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true">

        <!-- Google Cast: aponta pro provider de opções -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.aotv.app.CastOptionsProvider" />

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:screenOrientation="fullUser"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- AniList (v1.17.0): retorno do OAuth no navegador para o app (aotv://anilist/callback). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aotv" android:host="anilist" android:path="/callback" />
            </intent-filter>
            <!-- Watch Party (Lote 10, v1.20.0): convite por deep link (aotv://party/?code=XXXXXX). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aotv" android:host="party" />
            </intent-filter>
            <!-- Deep link stremio:// (Lote 17, v1.27.0): instalar addon pelo
                 link (ex.: tocado no navegador) — o app aparece no "Abrir com". -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="stremio" />
            </intent-filter>
        </activity>

        <!-- Ícones coloridos (Lote 11, v1.21.0 — ideia do Tuvora): um alias por
             cor, todos DESLIGADOS por padrão. O ícone atual continua sendo a
             MainActivity (sem alias). Trocar o ícone liga o alias da cor e
             desliga a MainActivity (ver AppIconVariants.applyVariant); voltar
             ao Padrão faz o contrário. Os deep links (AniList, Watch Party e stremio://)
             estão duplicados em cada alias porque, com a MainActivity
             desligada, o link só resolve no alias ativo — em cada estado só
             UM componente está ligado. O banner é o mesmo do app em todos. -->
        <activity-alias
            android:name=".AppIconRed"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_red"
            android:roundIcon="@mipmap/ic_launcher_red"
            android:banner="@drawable/ic_launcher_foreground"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aotv" android:host="anilist" android:path="/callback" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aotv" android:host="party" />
            </intent-filter>
            <!-- Deep link stremio:// (Lote 17, v1.27.0): instalar addon pelo
                 link (ex.: tocado no navegador) — o app aparece no "Abrir com". -->
            <intent-filter>
