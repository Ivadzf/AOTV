        <!-- Atualizador dentro do app (Lote 12, v1.22.0): expõe o APK baixado
             da release oficial p/ o instalador do sistema. Só o cache do app,
             só o arquivo da atualização — nenhum outro diretório. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.aotv.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Gravação de stream ao vivo (Lote 8): baixa HLS/TS em 2º plano com notificação persistente. -->
        <service
            android:name=".data.recordings.RecordingService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Send to TV (Lote 22, item 2): as ações Pause/Continuar/Parar da
             notificação. Só o próprio app envia (exported=false); o receiver
             lê o ID da sessão do extra e chama o SendToTvSessionManager. -->
        <receiver
            android:name=".data.remote.SendToTvActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.aotv.app.SEND_TO_TV_PAUSE" />
                <action android:name="com.aotv.app.SEND_TO_TV_RESUME" />
                <action android:name="com.aotv.app.SEND_TO_TV_STOP" />
            </intent-filter>
        </receiver>
